DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ecodrop_dev
APP_NAME=EcoDrop API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Generate a unique secret locally; do not use this placeholder in a deployed environment.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
